[node name="MainElevator" parent="." index="27" instance=ExtResource( 1 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 0, -448 )
roomName = "General Elevator"
roomDescription = "You step into the elevator. It's a massive cargo elevator, clearly designed to move extremely large amounts of cargo to and from various floors of the prison. You can tell it's seen much use given the rusty gears that are used to move the elevator up and down. Looking up, you can see a virtuously endless number of floors, enough to give you vertigo as you try to process them all.

There is a panel on the right where you came in. There's a bunch of different buttons and whatnot that you can use to go up and down to various floors.

Currently, you're on the bottom floor; the Main Hall."
roomSprite = 3
roomColor = 2
population = 3

