[node name="MainConnector" parent="." index="29" instance=ExtResource( 1 )]
position = Vector2( 0, 192 )
roomName = "Corridor"
roomDescription = "You stroll through the large corridor leading away from the central chamber, leading toward the tram station. Your brain tells you this is supposed to be a connector to the green zone, but that isn't the case. Not anymore.

Just to the south is a security checkpoint that pats down every inmate that comes from the tram line, making sure they don't have any illegal items on them."
population = 3

