[node name="MainSalvEnt" parent="." index="25" instance=ExtResource( 1 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -128, -320 )
roomName = "Salvage Stairs"
roomDescription = "The sounds of heavy machinery running nearly deafens you as you move through the engineering zone. Engineers walk around you carrying heavy materials, and sometimes the occaisonal inmate is seen with some tools aiding in the engineering of various things. Maybe you'll be able to help out one day.

These stairs lead down into the salvage area, where salvagers and many inmates end up."
roomColor = 8
population = 3

