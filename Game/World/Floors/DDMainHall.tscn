[node name="DDMainHall" instance=ExtResource( 2 )]

[node name="MainHall" parent="." index="0" instance=ExtResource( 1 )]
roomName = "Central Chamber"
roomDescription = "You step into the central chamber, the massive lights above blinding you for a short moment. You look up at the lights, seeing the faint silhouettes of the guard catwalks, as well as the barely noticable outlines of soldiers looking down at you, patrolling back and forth. You can barely see the glow of their rifles through the blinding lights. Your eyes begin to feel sore and you look away. As your eyes adjust, you see groups of inmates divided and chatting amongst each other. Reds stay to the far corners, while Oranges are gathered more toward the center. Lilacs are nowhere to be seen.

As you step into the center of the chamber, you watch as an inmate gets dragged. They kick and scream in fear as a set of chains is lowered down to the guards dragging them. Before your eyes, you watch as they get cuffed to the chains before being hoisted up and dangled from the catwalks, hanging there and being put on display. Another dreadful reminder that dissonance will not be tolerated."
roomSprite = 4
population = 3

