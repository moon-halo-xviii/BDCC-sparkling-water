[node name="MainLaundry" parent="." index="33" instance=ExtResource( 1 )]
self_modulate = Color( 0.7, 0.7, 1, 1 )
position = Vector2( 192, 0 )
roomName = "Laundry Room"
roomDescription = "You stroll through the large corridor leading away from the central chamber, leading into the laundry room. At least something feels familiar around here. It's a pretty similar setup to the other prison, however there is no uniform vendor here. In its place is a bunch of laundry machines and an engineer with a crate of uniforms. There's also a sewing kit for those trying to fix their uniform. It looks well used."
roomSprite = 9
roomColor = 3
population = 3

