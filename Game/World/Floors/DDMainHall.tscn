[node name="MainFactory" parent="." index="109" instance=ExtResource( 1 )]
self_modulate = Color( 1, 0.8, 0.6, 1 )
position = Vector2( 192, -384 )
roomName = "Manufacturing Zone"
roomDescription = "You step into the manufacturing zone, the sounds of machinery becoming louder and louder as you get closer and closer to the sounds of working machines. It seems that this is where most of the inmates work, as you can see rows upon rows of inmates assembling various tools and other important equipment that could be used by the likes of soldiers and/or guards.

You're approached by a big wolf who cracks his knuckles.

[b]Boss:[/b] [color=yellow]\"Hope you got some ID on you.\"[/color]

You pull out an identification card and give it to the big wolf who huffs and passes it back. Seems like he was hoping for a fight. He motions inward and gets out of the way."
roomColor = 5
gridColor = 6
loctag_EngineersEncounter = true
loctag_Offlimits = true
population = 2

[node name="MainFactory2" parent="." index="110" instance=ExtResource( 1 )]
self_modulate = Color( 1, 0.8, 0.6, 1 )
position = Vector2( 256, -384 )
roomName = "Manufacturing Zone"
roomDescription = "You step deeper into the manufactoring zone, being surrounded on all sides by complex machinery. You don't really know what you're doing here, but given the instructions that the security officer gave you, you're supposed to find an empty bay and start working. Given how hard these people are working, it might be pretty hard to find a spot to start.

It's really loud in here..."
roomColor = 5
gridColor = 6
loctag_EngineersEncounter = true
loctag_Offlimits = true
population = 2

