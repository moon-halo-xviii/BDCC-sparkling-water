roomDescription = "Humidity sticks to your fur as you walk around the hydroponics, making you feel all sweaty and damp. It's really hot in here. Going off the marks on the wall, you shouldn't be here. As a matter of fact, there's a red [color=red]Off-Limits[/color] sign on the wall to your right.

You can see various gardeners around in heavy gear carrying large fumigators. They don't look the type to take kindly to tresspassers... might be a good idea to avoid them."
roomColor = 1
gridColor = 2
loctag_Greenhouses = true
loctag_GuardsEncounter = true
loctag_Offlimits = true
population = 2

