position = Vector2( -128, -384 )
roomName = "Medical Hall"
roomDescription = "You enter the open rooms of the Clinical Wing, beds scattered around about as much as the medical staff. You spot various inmates being treated out in the open with minor wounds that don't require more invasive medication, nor cryopod usage. Some inmates however are being taken to dedicated rooms with the posibility of a short-time stay, as their wounds are more severe and they can't afford cryopod treatment."
gridColor = 1
population = 2

