[node name="MedicalFloor4" parent="." index="3" instance=ExtResource( 2 )]
position = Vector2( -192, 0 )
roomName = "Medical Lobby"
roomDescription = "You step into the sterile lobby of the medical floor. Doctors and nurses run around rampant in this place and every few minutes an alarm goes off before paramedics are dispatched. Many of the paramedics come back with stretchers carrying wounded inmates. Others come back with body bags. A constant reminder that life is a fleeting thing in this prison.

You look at the guard watching the entrance gate. Every once in a while a group of new prisoners arrive, being escorted by various personnel. Trying to get closer results in your collar sparking angrily."
canEast = false
canSouth = false
population = 3

