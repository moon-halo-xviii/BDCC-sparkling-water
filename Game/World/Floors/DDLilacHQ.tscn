[node name="LilacCheckpoint" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( 0, 256 )
roomName = "Checkpoint"
roomDescription = "Where there was once a checkpoint is a heavily sealed off door with a closed viewport on the upper-half of the door itself. The door is heavily armored with welded steel panels and thick armor plating. It's clear that people have tried to break in from the heavy abuse present on the door, with remnants of dents and scorch marks from attempted arson.

On the door is a simple warning:

[color=pink]LILACS & LILAC GUESTS ONLY BEYOND THIS POINT[/color]

Looks like you won't get in without permission..."
canNorth = false
roomSprite = 4
roomColor = 4
gridColor = 7
population = 3

