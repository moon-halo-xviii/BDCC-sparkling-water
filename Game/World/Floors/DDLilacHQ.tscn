[node name="LilacMain55" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( 192, -64 )
roomName = "Lilac Main Hall"
roomDescription = "You enter the eastern side of the Lilac, and immediately you're covered in whores of various caliber, male and female and all inbetween. They drape you with their bodies, but with a masterful precision you are able to avoid their advances enough to move around. It's clear you've entered the slave market, or at least the whore market. Several people, seemingly slave owners, shout at the ones who drape themselves over you and one by one they leave you be. This area doesn't seem to hold much value... but at the same time this could be a good spot to relieve yourself."
roomColor = 4
population = 3

