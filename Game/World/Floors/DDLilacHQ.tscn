[node name="LilacMain51" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( -192, -64 )
roomName = "Lilac Black Market"
roomDescription = "You enter the western side of the Lilac Block, entering what can only be called a black market. Market stalls are set in rows upon rows and the people manning them, obviously smugglers, drug dealers, and whatnot, try to get your attention in an attempt to get you to purchase one of their wares. Very few have anything you could care about, but there are a select few you can notice that seem to have stuff you could use. Might be worth checking out."
roomColor = 4
population = 3

