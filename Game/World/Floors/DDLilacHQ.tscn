self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( 0, 192 )
roomName = "Lilac Entrance Hall"
roomDescription = "The heavy door slams behind you as you pass the doorman, giving you a sly smirk as you take in the sudden change of atmosphere. The air is heavy with lavender, but also tobacco smoke and other potent fragrances. Enough to make you choke a little bit, but not enough to draw attention to yourself.

Curtains cover the door leading into the main hall, blocking your vision."
roomColor = 4
population = 3

[node name="LilacMain2" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( 0, 128 )
roomName = "Lilac Main Hall"
roomDescription = "You step out and into the main hall, shocked to see the lilacs and their living conditions. They live like royalty here, and that is echoed in the fact that the lilac block is similar to that of a bazzar from some desert movie, with various lilac prisoners advertising their goods to passing guests of orange, red, and lilac variety. Of course, there are also the cells full of whores who sell themselves for sex and profit.

In the center of the hall is a throne, and sitting atop it is a huge lilac. She easily towers over everyone in the room, and it's clear that she has her sights set on you, staring at you with amusement on her face as you enter the main hall of the lilac block."
roomColor = 4
population = 3

[node name="LilacMain26" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( 128, 64 )
roomName = "Lilac Main Hall"
roomDescription = "You roam the main hall of the lilac block. This area is significantly altered from the usual block structure, and you can't tell if the lilacs did that themselves or if they paid the prison engineers to do it for them. In either case, the area is absolutely huge. To the north is the living quarters, housing all of the \"cells.\" To the east is the Sex Market, where lilacs will whore themselves out or sell various lewd goods. To the west is the Bazaar District, but it's more like a black market, dealing with contraband and other things that would definitely get you sent to solitary... or worse.

In the center of the room is the throne, where the Lilac Queen sits, watching you roam."
roomColor = 4
population = 3

