[node name="RedBlock" parent="DDRedBlock" instance=ExtResource( 3 )]
position = Vector2( 0, 192 )
roomName = "General Block"
roomDescription = "You enter the Red Block and instantly you feel like you're in danger. Groups of red inmates gather around the main area of the block, and they all turn to stare at you as you enter their territory. You've entered the lair of the beast, and the beast is a bunch of inmates who are in here for significantly worse things than you... most of these guys are syndicate members, and you can see it in their eyes that they want nothing more than to rip you to shreds. But it seems the looming threat of being shot is very much keeping them at bay. You better go about your business quick..."

[node name="RedBlock2" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 0, 128 )
roomName = "Red Block"
roomDescription = "As you walk around the Red Block, you notice a lot of inmates in red uniforms. They hang around in groups in the center area, creating fighting pits to test their strength. Above you, you can spot the usual guards on catwalks, their visors glowing green as they keep close watch on the inmates under their supervision. However, it is clear these guards are significantly more heavily armed, with bigger weapons and heavier armor. Looking to your left, you see the wall of cells that expand both up and down. Directly ahead of you is the cafeteria, and it seems like they, too, eat sludge.. To the right is the bathrooms and showers. Even from here you can see blood trails leading in and out of that area."
roomColor = 2

