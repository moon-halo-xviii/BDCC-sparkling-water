[node name="RedBlock4" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.8, 0.6, 1 )
position = Vector2( -128, 128 )
roomName = "General Block"
roomDescription = "As you roam the General Block, you notice a lot more inmates in orange uniforms. They hang around with not much to do in the center area. Above you, you can spot the usual guards on catwalks, their visors glowing green as they keep close watch on the inmates under their supervision. Looking to your left, you see the wall of cells that expand both up and down. Directly ahead of you is the cafeteria, and it seems like you're back to eating sludge. To the right is the bathrooms and showers. Even from here you can hear some moans as people enjoy themselves a bit too much."
roomColor = 5

