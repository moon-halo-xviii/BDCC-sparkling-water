roomDescription = "You enter the canteen, the smell of the usual nutrient paste and water hitting your nose. In an instant you scrunch up your nose. You look around, seeing a few old server counters that clearly haven't been used in years. On the opposite side is an automated dispenser of nutrient paste and a long line of inmates, each one looking extremely tired of this slop they've been given for who knows how long. Guess you should get in line..."

[node name="RedBlock53" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -128, -320 )
roomName = "Canteen"
roomDescription = "You enter the canteen, the smell of the usual nutrient paste and water hitting your nose. In an instant you scrunch up your nose. You look around, seeing a few old server counters that clearly haven't been used in years. On the opposite side is an automated dispenser of nutrient paste and a long line of inmates, each one looking extremely tired of this slop they've been given for who knows how long. Guess you should get in line...

Hey look a table! Oh. It's full."
roomColor = 8

[node name="RedBlock28" parent="DDRedBlock" instance=ExtResource( 3 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 64, -64 )
roomName = "Red Block"
roomDescription = "As you walk around the Red Block, you notice a lot of inmates in red uniforms. They hang around in groups in the center area, creating fighting pits to test their strength. Above you, you can spot the usual guards on catwalks, their visors glowing green as they keep close watch on the inmates under their supervision. However, it is clear these guards are significantly more heavily armed, with bigger weapons and heavier armor. Looking to your left, you see the wall of cells that expand both up and down. Directly ahead of you is the cafeteria, and it seems like they, too, eat sludge.. To the right is the bathrooms and showers. Even from here you can see blood trails leading in and out of that area."
canNorth = false
roomColor = 2

