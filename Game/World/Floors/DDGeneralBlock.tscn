[node name="GeneralBlock33" parent="DDGeneralBlock" instance=ExtResource( 3 )]
position = Vector2( 0, -128 )
roomName = "Canteen"
roomDescription = "You enter the canteen, the smell of the usual nutrient paste and water hitting your nose. In an instant you scrunch up your nose. You look around, seeing a few old server counters that clearly haven't been used in years. On the opposite side is an automated dispenser of nutrient paste and a long line of inmates, each one looking extremely tired of this slop they've been given for who knows how long. Guess you should get in line..."

