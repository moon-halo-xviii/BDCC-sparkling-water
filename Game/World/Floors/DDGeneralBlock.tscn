[node name="GeneralBlock19" parent="DDGeneralBlock" instance=ExtResource( 3 )]
self_modulate = Color( 0.5, 0.5, 0.5, 1 )
position = Vector2( -256, 64 )
roomName = "You and Anya's Cell"
roomDescription = "You enter your cell that you share with Anya. Her side is significantly more decorated than your side, featuring numerous posters. She kept this place [i]very[/i] tidy and you can't help but appreciate that as you look over at your side. Your side is a completely blank slate, with no decorations or even a poster. Though, there is a small table and on said table there is a small lavender plant that Anya gave you."
canWest = false
canNorth = false
canSouth = false
roomSprite = 10
roomColor = 7

