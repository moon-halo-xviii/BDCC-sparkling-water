[node name="GeneralBlock" parent="DDGeneralBlock" instance=ExtResource( 3 )]
position = Vector2( 0, 192 )
roomName = "General Block"
roomDescription = "You enter the General Block, leaving the checkpoint behind and taking in the sights. Automatically you notice a lot more inmates in orange uniforms. They hang around with not much to do in the center area. Above you, you can spot the usual guards on catwalks, their visors glowing green as they keep close watch on the inmates under their supervision. Looking to your left, you see the wall of cells that expand both up and down. Directly ahead of you is the cafeteria, and it seems like you're back to eating sludge. To the right is the bathrooms and showers. Even from here you can hear some moans as people enjoy themselves a bit too much."

